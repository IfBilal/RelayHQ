# Copy to .env.local. Never commit real values.
APP_URL=http://localhost:3000

# Supabase (local `npx supabase start` prints these)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte base64 key for encrypting provider tokens at rest
INTEGRATION_ENCRYPTION_KEY=
# Shared secret that protects /api/jobs/dispatch-outbox
CRON_DISPATCH_SECRET=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Resend (escalation alerts)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
