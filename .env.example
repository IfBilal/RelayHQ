# Copy to .env.local. Never commit real values. [S] = secret: server-only, never NEXT_PUBLIC_*.

# Public https URL of the deployment (no trailing slash). REQUIRED in production: used in alert emails and OAuth/webhook callbacks.
APP_URL=http://localhost:3000

# Supabase. NEXT_PUBLIC_* must be set at BUILD time (the CSP connect-src is derived from the URL).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # [S]

# 32-byte base64 key for encrypting provider tokens at rest: `openssl rand -base64 32`
INTEGRATION_ENCRYPTION_KEY=           # [S]
# Shared secret that protects /api/jobs/dispatch-outbox: `openssl rand -hex 32`
CRON_DISPATCH_SECRET=                 # [S]

# Stripe (test mode)
STRIPE_SECRET_KEY=                    # [S]
STRIPE_WEBHOOK_SECRET=                # [S]

# Google Calendar OAuth (per-user, PKCE)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                 # [S]
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Escalation alert email over SMTP (Gmail: smtp.gmail.com, port 465 or 587, an app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=                            # [S]
SMTP_FROM=
